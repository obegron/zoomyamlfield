{
  "name": "vscode-yaml-field-editor",
  "displayName": "YAML Field Editor",
  "description": "Zoom and edit YAML fields",
  "publisher": "obegron",
  "version": "0.0.9",
  "repository": "git@github.com:obegron/zoomyamlfield.git",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.zoomYamlField",
        "title": "Zoom edit YAML Field"
      },
      {
        "command": "extension.exitZoomYamlField",
        "title": "Exit Zoom edit YAML Field"
      },
      {
        "command": "extension.activateYamlKey",
        "title": "Zoom edit YAML Field"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == yaml",
          "command": "extension.activateYamlKey",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "YAML Field Editor",
      "properties": {
        "yamlFieldEditor.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the output channel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "package:release": "npm run package && 7z d *.vsix extension/.github/ extension/.vscode/ extension/src/test/ extension/out/test/ extension/.gitignore extension/src/extension.ts extension/tsconfig.json"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.8",
    "@types/node": "^24.x",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.48.1",
    "@vscode/test-electron": "^2.1.3",
    "eslint": "^9.39.1",
    "mocha": "^11.7.5",
    "typescript": "^5.6.2",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "files": [
    "out",
    "node_modules",
    "CHANGELOG.md",
    "LICENSE.txt",
    "README.md",
    "package.json"
  ]
}
